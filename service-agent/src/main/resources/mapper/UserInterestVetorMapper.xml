<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.murk.serviceagent.Mapper.UserInterestVetorMapper">


    <select id="selectUserInterestById" resultType="com.murk.serviceagent.pojo.UserInterestVetor">
        select style_tags,last_update_time from user_interest_vetor where user_id=#{userId}
        order by last_update_time desc limit 20
    </select>
</mapper>